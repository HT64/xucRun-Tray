<?xml version="1.0" encoding="utf-8"?>
<!-- Purpose: Defines public Tray build paths and optional external release signing. -->
<Project>
  <PropertyGroup>
    <XucRunCoreRoot Condition="'$(XucRunCoreRoot)'==''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\xucRun-Core'))</XucRunCoreRoot>
    <XucRunTrayOutputRoot Condition="'$(XucRunTrayOutputRoot)'==''">$(MSBuildThisFileDirectory)artifacts\$(Configuration)</XucRunTrayOutputRoot>
    <SignTrayArtifacts Condition="'$(SignTrayArtifacts)'==''">false</SignTrayArtifacts>
  </PropertyGroup>
</Project>
