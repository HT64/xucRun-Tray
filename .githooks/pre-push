#!/bin/sh
# Purpose: Blocks pushes unless the public Tray repository and destination are verified.

repository_root=$(git rev-parse --show-toplevel) || exit 1
powershell.exe -NoProfile -ExecutionPolicy Bypass \
    -File "$repository_root/Test-PublicRepository.ps1" \
    -RepositoryRoot "$repository_root" \
    -PushRemoteName "$1" \
    -PushRemoteUrl "$2"
