<?xml version="1.0" encoding="utf-8"?>
<!--
  Purpose: Enforces shared prerequisites and resource freshness for all Tray builds.
  Approach: Validates sibling and signing paths before building and deletes stale resource output.
-->
<Project>
  <Target Name="ValidateXucRunTrayWorkspace" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(XucRunCoreRoot)\xucRunCore\xucRunCore.vcxproj')"
      Text="The pinned sibling xucRun checkout is missing at $(XucRunCoreRoot)." />
    <Error Condition="'$(SignTrayArtifacts)'=='true' and !Exists('$(XucRunSignScript)')"
      Text="Tray signing was requested, but XucRunSignScript does not identify an existing signing script." />
  </Target>
  <Target Name="ForceSharedResourceCompilation" BeforeTargets="ResourceCompile">
    <Delete Files="$(IntDir)ClientResources.res" />
  </Target>
</Project>
